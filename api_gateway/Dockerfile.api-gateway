FROM python:3.11-slim

WORKDIR /app

# Copiar requirements.txt primero para aprovechar la caché de Docker
COPY requirements.txt .

# Instalar dependencias
RUN pip install --no-cache-dir -r requirements.txt

# Copiar todo el código necesario
COPY api_gateway/ ./api_gateway/
COPY common/ ./common/
COPY microservices/protobufs/ ./microservices/protobufs/

# Copiar .env.example como .env si no existe un .env personalizado
COPY .env.example ./.env

# Establecer PYTHONPATH para permitir importaciones relativas
ENV PYTHONPATH=/app

# Exponer el puerto en el que corre el API Gateway (5000)
EXPOSE 5000

# Comando para ejecutar el API Gateway
CMD ["python", "api_gateway/app.py"]